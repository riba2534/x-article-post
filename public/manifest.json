{
  "manifest_version": 3,
  "name": "X Article Post",
  "short_name": "XArticlePost",
  "description": "Write Markdown, get a well-formatted X Article draft. Code, tables, LaTeX, Mermaid and images included.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/riba2534/x-article-post",
  "action": {
    "default_title": "X Article Post",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "tabs", "scripting", "offscreen", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
